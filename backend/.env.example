# Database Configuration
# For Async SQLite (Default zero-config):
DATABASE_URL=sqlite+aiosqlite:///./job_auto_apply.db

# For production PostgreSQL (supported by both the async app and Alembic):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/job_auto_apply
# Plain postgresql:// and postgres:// URLs also use psycopg automatically.
# URL-encode special characters in passwords. Use the same URL for API and workers.

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-secure-random-secret-key-for-local-auth
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Application
DEBUG=True
FRONTEND_URL=http://localhost:5173

# App-owned SMTP account for registration verification (required for new accounts).
# Port 587 uses STARTTLS. Port 465 automatically uses implicit TLS.
AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=your-smtp-username
AUTH_SMTP_PASSWORD=your-smtp-password
AUTH_SMTP_FROM_EMAIL=noreply@example.com
AUTH_SMTP_START_TLS=True
AUTH_SMTP_USE_TLS=False

# Broker for scheduled manual emails
CELERY_BROKER_URL=redis://localhost:6379/0
